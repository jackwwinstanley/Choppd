# Weekly TheMealDB catalog import into the `recipes` table (oneshot; run by the
# sizle-import.timer). Install:
#   sudo cp deploy/sizle-import.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now sizle-import.timer
# Run on demand:  sudo systemctl start sizle-import.service
# Logs:           journalctl -u sizle-import -n 50
[Unit]
Description=Sizle weekly TheMealDB catalog import
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/sizle/server
ExecStart=/usr/bin/node tools/import-all-mealdb.mjs
