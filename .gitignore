# --- SearTune / MusicCooking ---

# Copyrighted / large audio — never commit (see mvp/audio/README.txt)
mvp/audio/*.mp3
mvp/audio/*.m4a
mvp/audio/*.wav
mvp/audio/*.ogg
mvp/audio/*.flac
# (The four per-recipe "song" mp3s were COPYRIGHTED recordings — deleted in the soundtrack migration.
#  Never re-add them; the recipes play the copyright-free pool below.)
# The Choppd soundtrack pool — copyright-FREE, SHIPPABLE (served from mvp/, bundled into iOS via cap sync).
# Tracked on purpose so a clean clone / checkout-deploy ships sound (map §6). Add tracks per
# docs/HOW-TO-ADD-SOUNDTRACK.md; they must live here (NOT top-level /audio).
!mvp/audio/soundtrack/
!mvp/audio/soundtrack/*.mp3
# top-level /audio working folder (source files incl. copyrighted) — never commit
/audio/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Logs / temp
*.log
/tmp/

# Node (for the future Expo/React Native build)
node_modules/
.expo/
dist/
build/

# --- Backend API (server/) ---
server/node_modules/
server/dist/
# SQLite db files (local/testing); prod uses Postgres
server/data/
server/.env
server/.env.production
.env

# Playwright MCP ephemeral snapshots/screenshots
.playwright-mcp/

# build-time image generation staging (run gen-eggs-images.mjs; approved PNGs go to mvp/assets/recipes/eggs/)
tools/eggs-gen/
images/

# voice generation toolchain deps (kokoro-js/onnxruntime) — large, re-installable
tools/voicegen/node_modules/
