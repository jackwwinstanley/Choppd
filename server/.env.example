# SearTune API — copy to .env and adjust.
PORT=8788

# Comma-separated origins allowed to call the API (the web client).
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Secret used to sign JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=dev-only-change-me

# Where the SQLite file lives (relative to server/). Swap for Postgres at scale.
DB_PATH=./data/seartune.db

# Developer/tester code that unlocks Premium (matches the web client).
DEV_PREMIUM_CODE=Dev123

# DEV auth: when true, the login code is returned in the API response + logged
# (no email provider needed for local/testing). Set false once email is wired.
DEV_AUTH=true

# --- Production-only (leave blank for the local testing launch) ---
# Email provider for real OTP delivery (e.g. Resend). If set, codes are emailed.
# RESEND_API_KEY=
# AUTH_FROM_EMAIL=login@seartune.app
