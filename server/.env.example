# SearTune API — copy to .env and adjust.

# ── Core ────────────────────────────────────────────────────────────────────
PORT=8788
NODE_ENV=development                 # set "production" on the server (enforces a real JWT secret)

# Comma-separated origins allowed to call the API (your web client).
# In production set this to your real https origin, e.g. https://getchoppd.app
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Secret used to sign JWTs. CHANGE THIS — the server refuses the default in production.
#   generate one:  openssl rand -hex 32
JWT_SECRET=dev-only-change-me

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL EMPTY for local dev → uses SQLite (file at DB_PATH, zero infra).
# Set it to your RDS Postgres connection string in production → uses pg.
#   postgres://USER:PASSWORD@your-db.xxxx.us-east-1.rds.amazonaws.com:5432/seartune
DATABASE_URL=
DB_PATH=./data/seartune.db           # SQLite only (ignored when DATABASE_URL is set)
# PGSSL_DISABLE=true                  # only if connecting to a non-TLS Postgres (not RDS)
# PG_POOL_MAX=10

# ── Auth ────────────────────────────────────────────────────────────────────
# Google OAuth (production login). Create an OAuth 2.0 Client ID (type: Web) in
# the Google Cloud console; add your web origin to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# DEV email-OTP login. Auto-OFF once GOOGLE_CLIENT_ID is set. When true the login
# code is returned in the API response (no email provider needed) — dev/testing only.
# DEV_AUTH=false

# Developer/tester code that unlocks Premium (matches the web client).
DEV_PREMIUM_CODE=Dev123

# ── Serving / proxy ─────────────────────────────────────────────────────────
SERVE_CLIENT=false                   # true → Express serves the mvp/ web client from this same origin
# CLIENT_DIR=../mvp                  # override the static client path
TRUST_PROXY=1                        # number of proxies in front (ALB/Caddy/nginx = 1)
AUTH_RATE_LIMIT=30                   # max auth requests / 15 min / IP
