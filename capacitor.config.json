{
  "appId": "app.getchoppd.mobile",
  "appName": "Choppd",
  "webDir": "mvp",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#FE5D26FF",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0B0F",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
